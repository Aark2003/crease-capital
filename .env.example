# Vercel frontend: set this to your Render API URL, e.g. https://crease-capital-api.onrender.com
VITE_API_URL=

# Render API
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://your-app.vercel.app

# Neon PostgreSQL connection string. The current MVP uses the Render persistent SQLite disk;
# this is reserved for the PostgreSQL migration before switching production persistence to Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
